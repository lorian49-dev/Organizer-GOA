<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search result</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="../styles/index.css">
</head>
<body>
     <div class="container">
     <nav>
        <span class="back-home"  onclick="goHome()">
            <i class="fa-solid fa-arrow-left"></i>
        </span>
        <ul class="list-navegation-ul">
        <li><i class="fa-solid fa-bars-staggered" title="Expandir menu"></i></li>
         <li><i class="fa-solid fa-magnifying-glass"></i>  
          <form action="/search-mid" class="form-search-glass form-documents" method="get">
           <label class="label-for-search-input">
            <input type="text" name="glass_model" id="search-glass" placeholder="Buscar de Montura..." autocomplete="off">
             <div class="field-results-glasses">
            
             </div>
           </label>
          </form>
         </li>
         <% if(userId === 1){%>
         <li><a href="/monturas"><span class="bold"><i class="fa-solid fa-glasses"></i><span class="nav-description">Monturas</span></span></a></li>
         <li><a href="/facturas"><i class="fa-solid fa-file-invoice-dollar"></i><span class="nav-description">Facturas</span></a></li>
         <li><a href="/manifiestos"><i class="fa-solid fa-file-invoice"></i><span class="nav-description">Manifiestos</span></a></li>
         <%}%>
        </ul>
        <!--Boton de Cierre de sesion-->
         <button id="btn-log-out" onclick="logoutBtn()" title="cerrar sesion"><i class="fa-solid fa-power-off"></i></button>
      </nav>
    <div class="table-results-container">
        <table class="table-search-results">
        <thead>
          <th></th>
          <th>marca</th>
          <th>Codigo</th>
          <th>Referencia</th>
          <th>color</th>
          <th>Numero de orden</th>
          <% if(userId === 1){%>
          <th>Ver Factura</th>
          <%}%>
          <th>Ver Manifiesto</th>
        </thead>
        <tbody class="table-body-results">

        </tbody>
    </table>
    </div>
</div>
<script>
  // definicion de variable global para obtener el roll del usuario
  const idRoleUser = <%= userId || null%>;
</script>
<script src="../events/search.js"></script>
</body>
</html>